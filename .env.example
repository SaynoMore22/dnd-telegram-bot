# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user id через запятую (узнать: @userinfobot). Можно добавлять новых.
ALLOWED_USER_IDS=

# Путь к SQLite (по умолчанию data/dnd.db)
DATABASE_PATH=data/dnd.db

# Опционально: OpenAI API key для распознавания голосовых (Whisper).
# Без ключа голосовые сообщения бот вежливо откажет.
OPENAI_API_KEY=

# База сайта (5e24)
DND_BASE_URL=https://next.dnd.su
